# Editor basics for every editor; formatting itself is Biome's (biome.json) and rustfmt's.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.rs]
indent_size = 4

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false
max_line_length = 80

[*.{bat,cmd}]
end_of_line = crlf

# Other programs' exports, kept byte for byte as they wrote them.
[**/tests/fixtures/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
end_of_line = unset
charset = unset
