{
  "extends": "@donizetti/tooling/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": ".",
    "types": ["node"],
    // The root's cache, so `mise run clean` removes it and scripts/ gets no node_modules of its own.
    "tsBuildInfoFile": "${configDir}/../node_modules/.cache/tsc/scripts.tsbuildinfo"
  },
  "include": ["**/*.ts"]
}
